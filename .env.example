SECRET_KEY=your_secret_key_here
DOMAIN=http://localhost:8000
FRONTEND_URL=http://localhost:3000
ENV=local
USE_JSON_LOGS=False
SENTRY_DSN=

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=336
REFRESH_TOKEN_EXPIRE_DAYS=21
SUDO_TOKEN_EXPIRE_MINUTES=60

PRIMARY_DATABASE_URL=postgresql://user:password@localhost/fastapi_template
REPLICA_DATABASE_URL=postgresql://user:password@localhost/fastapi_template
TEST_DATABASE_URL=postgresql://user:password@localhost/fastapi_template_test
MIN_CONNECTION_COUNT=1
MAX_CONNECTION_COUNT=10
REGION_PRIORITY=us-east-1
HEALTH_CHECK_INTERVAL=30

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_DB_CELERY_BROKER=1
REDIS_DB_CELERY_BACKEND=2
REDIS_DB_SOCKET=3
REDIS_DB_EVENT_BUS=4

S3_ENDPOINT_URL=http://localhost:4566
S3_REGION_NAME=us-east-1
AWS_ACCESS_KEY=test
AWS_SECRET_ACCESS_KEY=test
AWS_BUCKET_NAME=my-bucket
ALLOWED_CONTENT_TYPES='["image/jpeg", "image/png", "image/webp", "application/pdf"]'

SENDGRID_API_KEY=your_sendgrid_api_key
EMAILS_FROM_EMAIL=your_email@domain.com
EMAILS_FROM_NAME="FastAPI Template"
